Meta.DisplayName=Pokémon Essentials MMO Kit (Container)
Meta.Description=Native AMP Docker/Podman container, no Docker-in-Docker. Runs Ruby and local PostgreSQL in AMP container.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.Author=BatteryVoltic
Meta.URL=https://github.com/SamDreamsMaker/pokemon-essentials-mmo-kit
Meta.DisplayImageSource=none:
Meta.ConfigRoot=pemk-container.kvp
Meta.ConfigManifest=pemk-containerconfig.json
Meta.ConfigVersion=3
Meta.AppConfigId=7e3d96d9-d5ab-4368-9ad5-0174b5a99324
Meta.MinAMPVersion=2.6.2.6
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraContainerPackages=["git","ca-certificates","ruby","ruby-dev","bundler","build-essential","libpq-dev","postgresql","postgresql-client"]
App.DisplayName=Pokémon Essentials MMO Kit
App.RootDir=./PEMK/
App.BaseDirectory=./PEMK/
App.ExecutableLinux=/bin/bash
App.WorkingDir=./PEMK/
App.LinuxCommandLineArgs=
App.CommandLineArgs=start.sh
App.AppSettings={}
App.EnvironmentVariables={"PEMK_PORT":"{{GamePort}}"}
App.ExitMethod=OS_CLOSE
App.ExitTimeout=45
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[pemk-containerports.json]
App.PrimaryApplicationPortRef=GamePort
App.AdminMethod=STDIO
App.UpdateSources=@IncludeJson[pemk-containerupdates.json]
App.PreStartStages=[]
App.ForceUpdate=False
App.RapidStartup=False
App.ApplicationReadyMode=Immediate
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.MetricsRegex=
Limits.SleepMode=False
Limits.SleepOnStart=False
