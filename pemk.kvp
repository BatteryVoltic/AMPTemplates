Meta.DisplayName=Pokémon Essentials MMO Kit
Meta.Description=Self-hosted PEMK Ruby/PostgreSQL server via Docker Compose. Debian 13 only; Docker host access required.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.Author=Local AMP Template
Meta.URL=https://github.com/SamDreamsMaker/pokemon-essentials-mmo-kit
Meta.DisplayImageSource=none:
Meta.ConfigRoot=pemk.kvp
Meta.ConfigManifest=pemkconfig.json
Meta.ConfigVersion=2
Meta.AppConfigId=7e3d96d9-d5ab-4368-9ad5-0174b5a99324
Meta.ContainerPolicy=NotSupported
Meta.DockerRequired=False
App.DisplayName=Pokémon Essentials MMO Kit
App.RootDir=./PEMK/
App.BaseDirectory=./PEMK/
App.ExecutableLinux=/usr/bin/docker
App.WorkingDir=./PEMK/project/server/
App.LinuxCommandLineArgs=
App.CommandLineArgs=compose -p pemk-amp -f docker-compose.yml up --build --no-color
App.AppSettings={}
App.EnvironmentVariables={"COMPOSE_ANSI":"never"}
App.ExitMethod=SIGINT
App.ExitTimeout=60
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[pemkports.json]
App.PrimaryApplicationPortRef=GamePort
App.AdminMethod=STDIO
App.UpdateSources=@IncludeJson[pemkupdates.json]
App.PreStartStages=[]
App.ForceUpdate=False
App.RapidStartup=False
App.ApplicationReadyMode=RegexMatch
Console.AppReadyRegex=.*(?:Listening on|listening on|server started|Server started|PEMK.*ready|pemk.*ready).*
Console.FilterMatchRegex=\x1b\[[0-9;]*[a-zA-Z]
Console.FilterMatchReplacement=
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.MetricsRegex=
Limits.SleepMode=False
Limits.SleepOnStart=False
